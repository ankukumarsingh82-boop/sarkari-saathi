# Optional. Leave every key blank for the deterministic local mode.
# A missing key, a failed call, or a timeout falls back to that mode.

# Gemini rewrites Hindi wording from the retrieved records. It does not decide eligibility.
# Keys are sent in the x-goog-api-key header. Any Google key format is accepted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Used only when GEMINI_API_KEY is empty. Same grounded rewrite.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Sarvam Hindi speech-to-text and text-to-speech. The key stays on the server.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# Firecrawl search for recent official links (*.gov.in and *.nic.in only).
FIRECRAWL_API_KEY=
