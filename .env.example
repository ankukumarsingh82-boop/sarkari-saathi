# Optional. Leave blank for the deterministic local mode (no API calls).
# The deployed demo is meant to work with neither key set.

# If set, free-form Hindi answers are generated by Gemini, grounded in the
# retrieved scheme records. Eligibility itself stays rules-based.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Used only when GEMINI_API_KEY is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
